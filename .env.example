# ============ WAJIB ============

# Token bot dari @BotFather
BOT_TOKEN=

# ID Telegram admin. Bisa lebih dari satu, dipisah koma: 123456,789012
ADMIN_ID=

# ============ PAYMENT GATEWAY: PAKASIR (API v2) ============
# Deposit saldo memakai Pakasir (https://pakasir.com) — metode QRIS, API v2.
# API v1 lama dihentikan Pakasir pada 20 Oktober 2026; bot ini sudah v2.
# Dokumentasi API: https://pakasir.com/p/docs

# Slug/nama project persis seperti di dashboard Pakasir (app.pakasir.com),
# ada di bagian bawah halaman Detail Proyek. Kalau salah, QRIS gagal dibuat.
PAKASIR_PROJECT=

# API key dari halaman detail project Pakasir.
PAKASIR_API_KEY=

# Siapa menanggung biaya QRIS:
#   merchant (default) = biaya ditanggung PENJUAL. Buyer membayar PERSIS nominal
#                        deposit; saldo masuk sebesar yang dibayar.
#   customer           = biaya ditambahkan ke tagihan buyer (buyer bayar lebih).
PAKASIR_FEE_BY=merchant

# (Opsional) Alamat dasar API Pakasir. Kosongkan untuk memakai default.
# PAKASIR_BASE_URL=https://app.pakasir.com

# (Opsional) URL callback/webhook. TIDAK WAJIB: bot juga memantau status sendiri
# lewat polling + tombol "Cek Status", jadi saldo tetap masuk tanpa webhook.
# Kalau diisi di dashboard Pakasir, endpoint di bot: <domain>/callback
# (juga /pakasir/callback). Isi webhook selalu diverifikasi ulang ke API Pakasir.
PAKASIR_CALLBACK_URL=


# ============ PENYIMPANAN DATA ============
# Bot TIDAK memakai database. Semua data disimpan di file JSON.

# Chat/channel tempat cadangan otomatis disimpan. Boleh sama dengan ADMIN_ID.
#
# SANGAT PENTING di hosting gratis (Render, dsb): filesystem-nya sementara,
# jadi file JSON hilang setiap container restart. Cadangan Telegram inilah
# yang membuat saldo buyer selamat — bot memulihkannya otomatis saat start.
# Kalau dikosongkan, bot tetap jalan tapi SEMUA SALDO HILANG setiap restart.
BACKUP_CHAT_ID=

# Lokasi file data (opsional). Kosongkan untuk memakai data/saldo.json.
DATA_FILE=


# ============ OPSIONAL ============

# Base URL script installer RDP (tanpa slash di akhir).
# Kalau domain script pindah, cukup ubah di sini — tidak perlu ubah kode.
RDP_SCRIPT_BASE=https://reemote.biz.id

# Port web service. Di Render diisi otomatis, biarkan kosong.
PORT=3000


# ============ FITUR CONTROL DO VIA API (DigitalOcean) ============
# Fitur "☁️ Control DO via API" TIDAK butuh konfigurasi di sini. Tiap buyer memasukkan
# Personal Access Token DigitalOcean-nya sendiri lewat chat, dan droplet dibuat
# di akun buyer itu (tagihan sewa droplet ditanggung buyer). Bot hanya memungut
# biaya layanan Rp1.000 flat per batch dari saldo bot.
