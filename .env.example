# ============ WAJIB ============

# Token bot dari @BotFather
BOT_TOKEN=

# ID Telegram admin. Bisa lebih dari satu, dipisah koma: 123456,789012
ADMIN_ID=

# API key payment gateway DompetX
API_KEY_DOMPETX=


# ============ PENYIMPANAN DATA ============
# Bot TIDAK memakai database. Semua data disimpan di file JSON.

# Chat/channel tempat cadangan otomatis disimpan. Boleh sama dengan ADMIN_ID.
#
# SANGAT PENTING di hosting gratis (Render, dsb): filesystem-nya sementara,
# jadi file JSON hilang setiap container restart. Cadangan Telegram inilah
# yang membuat saldo buyer selamat — bot memulihkannya otomatis saat start.
# Kalau dikosongkan, bot tetap jalan tapi SEMUA SALDO HILANG setiap restart.
BACKUP_CHAT_ID=

# Lokasi file data (opsional). Kosongkan untuk memakai data/saldo.json.
DATA_FILE=


# ============ OPSIONAL ============

# Base URL script installer RDP (tanpa slash di akhir).
# Kalau domain script pindah, cukup ubah di sini — tidak perlu ubah kode.
RDP_SCRIPT_BASE=https://reemote.biz.id

# Port web service. Di Render diisi otomatis, biarkan kosong.
PORT=3000


# ============ FITUR BUAT VPS (DigitalOcean) ============
# Fitur "☁️ Buat VPS" TIDAK butuh konfigurasi di sini. Tiap buyer memasukkan
# Personal Access Token DigitalOcean-nya sendiri lewat chat, dan droplet dibuat
# di akun buyer itu (tagihan sewa droplet ditanggung buyer). Bot hanya memungut
# biaya layanan Rp1.000 flat per batch dari saldo bot.
